% Three size tokens per layout; every text element uses one of these helpers.
% Leading controls line spacing only and does not introduce another font size.
\newcommand{\UseCampaignSizes}[3]{%
  \def\HeadlinePoints{#1}\def\ContextPoints{#2}\def\BodyPoints{#3}%
  \pgfmathsetmacro{\HeadlineLeading}{#1*1.05}%
  \pgfmathsetmacro{\ContextLeading}{#2*1.1}%
  \pgfmathsetmacro{\BodyLeading}{#3*1.18}%
}
\newcommand{\HeadlineFont}{\fontsize{\HeadlinePoints}{\HeadlineLeading}\selectfont}
\newcommand{\ContextFont}{\fontsize{\ContextPoints}{\ContextLeading}\selectfont}
\newcommand{\BodyFont}{\fontsize{\BodyPoints}{\BodyLeading}\selectfont}

% Original vector illustration. Geometry and labels are live TikZ elements.
% Arguments: lower-left x, lower-left y, width, height (all in mm).
\newcommand{\WaterScene}[4]{%
  \begin{scope}[shift={(#1,#2)},xscale=#3/180,yscale=#4/80]
    \clip (0,0) rectangle (180,80);
    \path[fill=Sky] (0,0) rectangle (180,80);
    % Compensate for scene aspect ratio so the sun remains circular in each layout.
    \pgfmathsetmacro{\SunRadius}{min(15*(#3/180),.19*#4)}
    \pgfmathsetmacro{\SunHorizontalRadius}{\SunRadius/(#3/180)}
    \pgfmathsetmacro{\SunVerticalRadius}{\SunRadius/(#4/80)}
    \path[fill=Yellow] (151,59) ellipse [x radius=\SunHorizontalRadius mm,y radius=\SunVerticalRadius mm];
    % Distant mountains.
    \path[fill=Cobalt!72] (59,0)--(108,61)--(126,40)--(153,65)--(192,14)--(192,0)--cycle;
    \path[fill=Cobalt] (95,0)--(128,49)--(140,35)--(162,57)--(194,13)--(194,0)--cycle;
    \path[fill=white] (108,61)--(98,48)--(107,51)--(113,45)--(118,49)--cycle;
    \path[fill=white!90!Sky] (153,65)--(142,52)--(151,55)--(157,50)--(163,52)--cycle;
    % Layered catchment hills.
    \path[fill=Mint] (0,20) .. controls (27,37) and (50,39) .. (76,27)
      .. controls (107,14) and (146,40) .. (180,28)--(180,0)--(0,0)--cycle;
    \path[fill=Teal] (0,9) .. controls (29,21) and (48,28) .. (76,19)
      .. controls (100,11) and (130,29) .. (180,17)--(180,0)--(0,0)--cycle;
    \path[fill=Ink!88!Teal] (0,0)--(0,6)
      .. controls (31,15) and (57,18) .. (76,12)
      .. controls (106,3) and (130,17) .. (180,7)--(180,0)--cycle;
    % River broadens toward the viewer.
    \path[fill=Cyan] (84,28) .. controls (83,23) and (102,23) .. (101,17)
      .. controls (100,11) and (78,11) .. (76,6)
      .. controls (75,3) and (81,1) .. (85,0)
      --(119,0) .. controls (102,6) and (97,6) .. (100,10)
      .. controls (104,15) and (113,17) .. (108,22)
      .. controls (104,26) and (89,26) .. (87,28)--cycle;
    \draw[white!65!Cyan,line width=.55mm] (86,27)
      .. controls (86,23) and (106,24) .. (105,19)
      .. controls (104,14) and (86,11) .. (86,7)
      .. controls (85,4) and (92,1) .. (99,0);
    % Stylised trees: entirely editable shapes.
    \foreach \x/\y/\s in {113/18/1,122/22/.8,131/25/1.1,143/22/1,158/19/1.2,170/17/.9} {
      \begin{scope}[shift={(\x,\y)},scale=\s]
        \draw[Ink,line width=.5mm] (0,-3)--(0,3);
        \path[fill=Ink] (-3.4,0)--(0,7)--(3.4,0)--cycle;
      \end{scope}
    }
    % Rain cloud and precipitation.
    \path[fill=white] (22,58) ellipse (17 and 7);
    \path[fill=white] (36,61) ellipse (16 and 9);
    \path[fill=white] (50,58) ellipse (13 and 7);
    \draw[white,line width=1.6mm,line cap=round] (15,56)--(52,56);
    \foreach \x in {18,28,38,48} {
      \draw[Cobalt,line width=.9mm,line cap=round] (\x,47)--+( -3,-7);
      \draw[Cyan,line width=.9mm,line cap=round] (\x-1,35)--+(-2,-5);
    }
    \node[fill=Yellow,text=Ink,rounded corners=2.4mm,inner xsep=2.9mm,inner ysep=1.5mm,font=\BodyFont\bfseries] at (63,42) {P};
    % Upward ET arrows are deliberately wavy rather than straight rainfall.
    \foreach \x in {130,143,156} {
      \draw[Yellow,line width=1.1mm,-{Stealth[length=3.2mm,width=2.8mm]},line cap=round]
        (\x,33) .. controls (\x-6,41) and (\x+5,44) .. (\x,55);
    }
    \node[fill=Ink,text=white,rounded corners=2.4mm,inner xsep=2.5mm,inner ysep=1.5mm,font=\BodyFont\bfseries] at (161,37) {ET};
  \end{scope}%
}

